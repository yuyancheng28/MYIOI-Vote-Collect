html, body {
  margin: 0;
  padding: 0;
  background: #0f172a;
  color: #e2e8f0;
  font-family: Arial, Helvetica, sans-serif;
}

* {
  box-sizing: border-box;
}

button, input, textarea {
  font: inherit;
}

.page-shell {
  min-height: 100vh;
  display: flex;
  justify-content: center;
  padding: 32px 16px;
}

.container {
  width: min(1100px, 100%);
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 24px;
}

.eyebrow {
  margin: 0;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: #38bdf8;
  font-size: 12px;
}

h1, h2, h3 {
  margin: 0 0 12px;
}

.grid {
  display: grid;
  gap: 24px;
}

.two-col {
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
}

.card {
  background: rgba(15, 23, 42, 0.9);
  border: 1px solid rgba(148, 163, 184, 0.2);
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.2);
}

label {
  display: block;
  margin-bottom: 14px;
  color: #cbd5e1;
  font-size: 14px;
}

input, textarea {
  display: block;
  width: 100%;
  margin-top: 6px;
  border: 1px solid rgba(148, 163, 184, 0.35);
  background: rgba(15, 23, 42, 0.75);
  color: white;
  border-radius: 10px;
  padding: 10px 12px;
}

textarea {
  min-height: 90px;
  resize: vertical;
}

button {
  border: none;
  border-radius: 10px;
  background: #334155;
  color: white;
  padding: 10px 16px;
  cursor: pointer;
}

button.primary {
  background: linear-gradient(135deg, #38bdf8, #8b5cf6);
  color: white;
  font-weight: 600;
}

.user-badge {
  display: flex;
  align-items: center;
  gap: 12px;
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid rgba(148, 163, 184, 0.2);
  padding: 10px 14px;
  border-radius: 10px;
}

.login-box {
  display: flex;
  align-items: center;
  gap: 10px;
}

.login-box input {
  width: 150px;
}

.poll-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.poll-item {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(30, 41, 59, 0.8);
  padding: 12px 14px;
  border-radius: 10px;
}

.vote-panel {
  margin-top: 24px;
}

.vote-form {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 18px;
}

.option-row {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(30, 41, 59, 0.6);
  padding: 12px;
  border-radius: 10px;
}

.option-row input {
  width: auto;
  margin: 0;
}

.results-box {
  margin-top: 20px;
  border-top: 1px solid rgba(148, 163, 184, 0.2);
  padding-top: 16px;
}

.result-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: rgba(15, 23, 42, 0.6);
  border-radius: 8px;
  padding: 10px 12px;
  margin-top: 8px;
}
